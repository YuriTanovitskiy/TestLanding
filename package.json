{
  "name": "landing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:bookings": "node --test server/bookingPlugin.test.mjs server/cloudflareBookings.test.mjs",
    "db:migrate:local": "wrangler d1 migrations apply BOOKINGS_DB --local --config wrangler.local.jsonc",
    "db:migrate:production": "wrangler d1 migrations apply BOOKINGS_DB --remote --env production",
    "dev:cloudflare": "wrangler pages dev dist --config wrangler.local.jsonc"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "wrangler": "^4.151.3"
  }
}
